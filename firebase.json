{
  "hosting": [
    {
      "target": "updates",
      "public": "dist-updates",
      "ignore": [],
      "headers": [
        {
          "//": "El feed manda la versión: si se cachea, un equipo puede seguir viendo la anterior durante horas.",
          "source": "*.yml",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
        },
        {
          "//": "Los instaladores llevan la versión en el nombre, así que nunca cambian de contenido.",
          "source": "**/*.@(zip|dmg|exe|blockmap)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    },
    {
      "target": "updates-dev",
      "public": "dist-updates-dev",
      "ignore": [],
      "headers": [
        {
          "source": "*.yml",
          "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
        },
        {
          "source": "**/*.@(zip|dmg|exe|blockmap)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        }
      ]
    }
  ]
}
