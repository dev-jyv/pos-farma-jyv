{
  "name": "farma-jyv-pos",
  "version": "1.0.2",
  "description": "FarmaJyV Venta — punto de venta de escritorio (Angular + Electron)",
  "main": "electron/main.js",
  "author": "FarmaJyV",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:electron": "npm run prisma:generate && vitest run --config electron/vitest.config.mjs",
    "test:all": "npm run test -- --watch=false && npm run test:electron",
    "prisma:generate": "prisma generate --schema=electron/prisma/schema.prisma",
    "electron:build": "npm run prisma:generate && ng build --configuration electron",
    "electron:start": "npm run electron:build && cross-env ELECTRON_RUN_AS_NODE= electron electron/main.js",
    "electron:dev": "npm run prisma:generate && cross-env ELECTRON_RUN_AS_NODE= NODE_ENV=development electron electron/main.js --dev",
    "electron:dist": "npm run electron:build && electron-builder",
    "electron:dist:mac": "npm run electron:build && electron-builder --mac",
    "electron:dist:win": "npm run electron:build && electron-builder --win",
    "postinstall": "prisma generate --schema=electron/prisma/schema.prisma",
    "db:migrate:dev": "cross-env DATABASE_URL=file:./dev.sqlite prisma migrate dev --schema=electron/prisma/schema.prisma",
    "release:prepare": "node scripts/publicar-actualizacion.mjs",
    "release:mac": "npm run electron:dist:mac && npm run release:prepare && firebase deploy --only hosting:updates",
    "release:win": "npm run electron:dist:win && npm run release:prepare && firebase deploy --only hosting:updates"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "build": {
    "appId": "mx.farmajyv.pos",
    "productName": "FarmaJyV Venta",
    "copyright": "Copyright © 2026 FarmaJyV",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "!**/*",
      "electron/**/*",
      "dist/farma-jyv-pos/browser/**/*",
      "package.json",
      "node_modules/@prisma/client/**/*",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@prisma/client/**/*",
      "**/.prisma/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://farma-jyv-updates.web.app"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "FarmaJyV Venta ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeuix/themes": "^3.0.0",
    "@prisma/client": "^6.19.3",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "primeicons": "^8.0.0",
    "primeng": "^22.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
